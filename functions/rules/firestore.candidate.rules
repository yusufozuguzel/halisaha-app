function accountActive(uid) {
  return uid is string && uid.size() > 0 && uid.size() <= 128
    && !uid.matches('.*[/].*')
    && !exists(/databases/$(database)/documents/accountDeletionJobs/$(uid));
}
function safetyWritesAllowed() {
  return request.auth != null && accountActive(request.auth.uid)
    && !exists(/databases/$(database)/documents/_moderationAccounts/$(request.auth.uid));
}
function abuseControlsEnabled() {
