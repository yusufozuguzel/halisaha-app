rules_version = '2';
service firebase.storage {
match /b/{bucket}/o {
// Merge inside /b/{bucket}/o; add this condition to EVERY existing write grant.
// Keep existing ownership, size and MIME checks. This helper grants nothing.
function safetyWritesAllowed() {
  return request.auth != null
    && !firestore.exists(/databases/(default)/documents/accountDeletionJobs/$(request.auth.uid))
    && !firestore.exists(/databases/(default)/documents/_moderationAccounts/$(request.auth.uid));
}

// The fixed .jpg object key is retained for existing profile URLs and workers.
// Actual MIME may also be PNG/WebP; the Flutter uploader sets it explicitly.
function ownsProfilePhoto(fileName) {
