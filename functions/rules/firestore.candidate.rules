    || resource.data.profileVersion == 2);
  allow list: if request.auth != null && resource.data.profileVersion == 2
    && request.query.limit != null && request.query.limit <= 50;
  allow create: if safetyWritesAllowed() && request.auth.uid == uid
    && validProfile(request.resource.data, uid)
    && !('username' in request.resource.data)
    && request.resource.data.get('avatarUrl', '') == ''
    && request.resource.data.get('blockedUsers', []).size() == 0
    && request.resource.data.get('createdAt', request.time) == request.time;
  allow update: if safetyWritesAllowed() && request.auth.uid == uid
    && validProfile(request.resource.data, uid)
    && (request.resource.data.get('avatarUrl', '') == resource.data.get('avatarUrl', '')
      || request.resource.data.get('avatarUrl', '') == '')
    && request.resource.data.get('username', '') == resource.data.get('username', '')
    && validBlockChange()
    && request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null);
