// Helper only. AND this into existing match update grants; it does not validate
// membership, capacity or position edits. Those need a separate policy.
function matchOwnerUnchanged() {
  return !request.resource.data.diff(resource.data).affectedKeys()
    .hasAny(['createdBy', 'creatorId']);
}
function validNewMatchOwner() {
  return request.auth != null
    && request.resource.data.createdBy == request.auth.uid
    && request.resource.data.creatorId == request.auth.uid;
}
function canDeleteMatch() {
  return request.auth != null
    && resource.data.get('createdBy', resource.data.get('creatorId', '')) == request.auth.uid;
}
