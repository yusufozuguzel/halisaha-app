}
match /_loginLimits/{document=**} { allow read, write: if false; }

// ---- social ----
// Merge inside /databases/{database}/documents, REPLACING the old grants for
// these paths. Requires safetyWritesAllowed() from firestore.fragment.rules.
// Never append under the old broad allows: Firestore combines grants with OR.
function signedIn() { return request.auth != null; }
function canReadSocialLists(userId) {
  return signedIn() && (request.auth.uid == userId
    || exists(/databases/$(database)/documents/users/$(userId)/friends/$(request.auth.uid))
      && exists(/databases/$(database)/documents/users/$(request.auth.uid)/friends/$(userId)));
}
function socialPairAllowed(a, b) {
  return a != b
    && exists(/databases/$(database)/documents/users/$(a))
    && exists(/databases/$(database)/documents/users/$(b))
    && !exists(/databases/$(database)/documents/accountDeletionJobs/$(b))
    && !exists(/databases/$(database)/documents/users/$(a)/blocks/$(b))
    && !exists(/databases/$(database)/documents/users/$(b)/blocks/$(a));
}
function acceptedPair(receiver, sender) {
