match /_moderationAccounts/{uid} {
  allow get: if request.auth != null && request.auth.uid == uid;
  allow list, write: if false;
}
match /_moderationRemovals/{document=**} { allow read, write: if false; }

match /contentReports/{document=**} {
  allow read, write: if false;
}
match /accountDeletionJobs/{document=**} {
  allow read, write: if false;
}
match /_safetyLocks/{document=**} {
  allow read, write: if false;
}
match /_reportLimits/{document=**} {
  allow read, write: if false;
}
match /_runtimePolicy/{document=**} { allow read, write: if false; }
match /_usernames/{document=**} { allow read, write: if false; }
match /_placesLimits/{document=**} { allow read, write: if false; }
match /_usernameLimits/{document=**} { allow read, write: if false; }
