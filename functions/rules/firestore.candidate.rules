function safePublicText(value, maximum) {
  return value is string && value.size() <= maximum
    && value.matches('^[^\\x00-\\x1F\\x7F]*$')
    && publicTextSafe(value);
}
function publicTextSafe(value) {
  return !value.lower().matches('(^|.*[^a-z0-9_])(orospu|siktir|sikerim|yarrak|yavşak|yavsak|gavat|pezevenk|kahpe|fuck|shit|bitch|asshole|pussy|cunt|whore|slut|faggot|nigger|nigga)([^a-z0-9_].*|$)');
