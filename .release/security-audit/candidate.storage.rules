// GENERATED by node functions/rules/assemble.cjs. Local candidate; NOT deployed.
rules_version = '2';
service firebase.storage {
match /b/{bucket}/o {
// Merge inside /b/{bucket}/o; add this condition to EVERY existing write grant.
// Keep existing ownership, size and MIME checks. This helper grants nothing.
function safetyWritesAllowed() {
  return request.auth != null
    && !firestore.exists(/databases/(default)/documents/accountDeletionJobs/$(request.auth.uid))
    && !firestore.exists(/databases/(default)/documents/_moderationAccounts/$(request.auth.uid));
}

// The fixed .jpg object key is retained for existing profile URLs and workers.
// Only the moderated server publishes/replaces bytes. Client MIME/metadata
// cannot prove a safe scan and must not grant upload permissions.
function ownsProfilePhoto(fileName) {
  return request.auth != null && fileName == request.auth.uid + '.jpg';
}
match /profile_images/{fileName} {
  allow get: if request.auth != null && fileName.matches('.*[.]jpg');
  allow list: if false;
  allow create, update: if false;
  // Deletion has no request.resource, and must work for legacy invalid files too.
  allow delete: if ownsProfilePhoto(fileName) && safetyWritesAllowed();
}
match /{allPaths=**} { allow read, write: if false; }
}
}
